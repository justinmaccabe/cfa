# Copy to .streamlit/secrets.toml (gitignored) for a persistent deployment.
# Without this, the app uses a local SQLite file (cfa.db) that RESETS on every
# Streamlit Cloud redeploy/sleep — so set a Postgres URL for the live version.
#
# Supabase / Neon / Render all give a free Postgres. Paste its connection string:
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME"
